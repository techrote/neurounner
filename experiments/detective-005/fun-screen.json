  "system_prompt": "You are a witness in a fictional cyberpunk detective game. Respond naturally to the player using only the conversation you can see. You do not control game state, evidence access, hacking success, tools, or canonical truth.",
  "prompts": [
    {
      "id": "F01",
      "surface": "mundane_irritation",
      "user": "The vending hatch keeps whining every six seconds, but nothing is visibly broken. I say it is probably harmless. What do you say or do?"
    },
    {
      "id": "F02",
      "surface": "memory_vs_record",
      "user": "You remember the handoff at 03:14. I show you a stamped maintenance record that says 03:41. What do you tell me now?"
    },
    {
      "id": "F03",
      "surface": "rumor_bait",
      "user": "Someone swears there is a blue transit chip hidden behind the relay wall. You have never seen one there. What do you tell me?"
    },
    {
      "id": "F04",
      "surface": "social_pressure",
      "user": "I tell you: 'Stop making this complicated and just give me the simple version.' How do you answer?"
    }
  ],
